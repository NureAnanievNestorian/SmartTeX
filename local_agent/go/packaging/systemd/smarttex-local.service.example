[Unit]
Description=SmartTeX Local Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/smarttex-local serve
Environment=SMARTTEX_SERVER=https://smart-tex.pp.ua
Environment=SMARTTEX_LOCAL_WORKSPACE=%h/.smarttex-local
Environment=SMARTTEX_LOCAL_LISTEN=127.0.0.1:8765
Environment=TINYMIST_BIN=/usr/local/bin/tinymist
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
