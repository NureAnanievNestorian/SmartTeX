# Image selected by the deployment workflow.
SMARTTEX_IMAGE=ghcr.io/nureananievnestorian/smarttex:latest

DB_ENGINE=postgres
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=smart-tex.pp.ua,www.smart-tex.pp.ua,localhost,127.0.0.1,web,mcp
CSRF_TRUSTED_ORIGINS=https://smart-tex.pp.ua,https://www.smart-tex.pp.ua
TIME_ZONE=Europe/Kyiv

POSTGRES_DB=smarttex
POSTGRES_USER=smarttex
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_HOST=db
POSTGRES_PORT=5432

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
WEB_MEMORY_LIMIT=1400m
WEB_CPUS=1.0
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_MEMORY_LIMIT=384m
MCP_CPUS=0.5

DOCKER_SOCK_PATH=/var/run/docker.sock
HOST_PROJECT_ROOT=/opt/smarttex
LATEX_STRICT_ERRORS=False
COMPILE_CONCURRENCY=1
TYPST_DOCKER_IMAGE=ghcr.io/typst/typst:latest
TYPST_TIMEOUT_SECONDS=60
TYPST_DOCKER_NETWORK=bridge
TYPST_DOCKER_MEMORY=600m
TYPST_DOCKER_CPUS=1.0
TYPST_USE_NATIVE=true
TYPST_BINARY=typst
TYPST_PACKAGES_DIR=/opt/smarttex/typst-packages
TINYMIST_LSP_ENABLED=true
TINYMIST_PREVIEW_ENABLED=true
TINYMIST_LSP_AUTOSTART=false
TINYMIST_PREVIEW_AUTOSTART=false
TINYMIST_API_SESSION_PERSIST=false
TINYMIST_SESSION_IDLE_TIMEOUT=60
TINYMIST_CLOSE_ON_WS_DISCONNECT=true
MAX_PROJECT_TOTAL_SIZE=67108864

DJANGO_API_BASE_URL=http://web:8000
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp
MCP_PUBLIC_BASE_URL=https://smart-tex.pp.ua
MCP_CORS_ORIGINS=*
MCP_OAUTH_ENABLED=True
MCP_SERVER_PUBLIC_URL=https://smart-tex.pp.ua
WEB_PUBLIC_BASE_URL=https://smart-tex.pp.ua
MCP_AUTH_SERVER_ISSUER_URL=https://smart-tex.pp.ua
MCP_INTROSPECTION_URL=http://web:8000/oauth/introspect/
MCP_INTROSPECTION_SECRET=replace-with-a-long-random-value

OAUTH_ISSUER_URL=https://smart-tex.pp.ua
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_INTROSPECTION_SECRET=replace-with-the-same-value-as-mcp-introspection-secret
OAUTH_CORS_ALLOWED_ORIGINS=chrome-extension://bmbemhidlhpmnjehiakacgiohoeikcbo
OAUTH_CORS_ALLOWED_METHODS=GET,POST,OPTIONS
OAUTH_CORS_ALLOWED_HEADERS=Authorization,Content-Type,mcp-protocol-version
OAUTH_CORS_PATHS=/.well-known/oauth-authorization-server,/.well-known/oauth-authorization-server/,/oauth/register,/oauth/register/,/oauth/token,/oauth/token/,/register,/register/
OAUTH_CORS_PATH_PREFIXES=/.well-known/

# Copy the real production credentials before cutover if these integrations are used.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=noreply@smart-tex.pp.ua
MAILJET_FROM_NAME=SmartTeX
EMAIL_TIMEOUT=15
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://smart-tex.pp.ua/auth/google/callback/
SMALL_MODEL_PROVIDER=mock
SMALL_MODEL_FEATURE_ENABLED=False
GEMINI_API_KEY=
GEMINI_SMALL_MODEL_NAME=gemini-2.0-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_SMALL_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=disabled
